# Скопируй эти значения в .env своего Laravel 13 после git clone

APP_URL=http://localhost:8485

# MySQL (основная БД)
DB_CONNECTION=mysql
DB_HOST=lara2-mysql
DB_PORT=3306
DB_DATABASE=lara2
DB_USERNAME=lara2
DB_PASSWORD=lara2

# Postgres + pgvector (Chat2 RAG)
DB_PGSQL_HOST=lara2-postgres
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=rag_core
DB_PGSQL_USERNAME=lara2
DB_PGSQL_PASSWORD=lara2

# Same key as Chat2 admin → Laravel RAG API Key
PLUGIN_API_KEY=123456sei091_2
PLUGIN_RAG_API_KEY=
